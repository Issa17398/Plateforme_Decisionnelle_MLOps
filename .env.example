# ==============================================================================
# Configuration pour Senegal Audiovisual Intelligence Platform
# ==============================================================================
# Copiez ce fichier sous le nom .env et renseignez vos valeurs réelles :
#   cp .env.example .env (ou Copy-Item .env.example .env sous PowerShell)
#
# ATTENTION : Ne versionnez JAMAIS le fichier .env (il est exclu par .gitignore)
# ==============================================================================

# Clé d'API Google Cloud pour YouTube Data API v3
# Doit être créée sur https://console.cloud.google.com/ et restreinte à YouTube Data API v3
YOUTUBE_API_KEY=votre_cle_api_youtube_ici

# Handles officiels vérifiés des chaînes YouTube cibles au Sénégal
MARODI_HANDLE=@maroditvprod
EVENPROD_HANDLE=@EvenProd
PIKINI_HANDLE=@PikiniProduction

# Timeout réseau pour les requêtes HTTP (en secondes)
YOUTUBE_REQUEST_TIMEOUT=30

# Configuration Airflow / Docker (Optionnel, défaut 50000)
AIRFLOW_UID=50000
